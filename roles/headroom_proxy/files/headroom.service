[Unit]
Description=Headroom AI Proxy Service
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Environment=HEADROOM_OUTPUT_SHAPER=1
Environment=HEADROOM_VERBOSITY_LEVEL=2
Type=simple
User=ai
WorkingDirectory=/home/ai
ExecStart=/home/ai/.local/bin/headroom proxy --port 8787 --host 100.66.37.58 --mode cache
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/ai/.headroom/logs/proxy.log
StandardError=append:/home/ai/.headroom/logs/proxy.log
Environment="PATH=/home/ai/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

[Install]
WantedBy=multi-user.target
